rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches Firebase Auth UID)
    // Model: Student
    // Fields:
    //   - id: string (required, 1-100 chars, immutable) - user's unique ID
    //   - displayName: string (required, 1-60 chars) - user's full/display name
    //   - major: string (required, 0-60 chars) - student's field of study
    //   - year: string (required, 0-30 chars) - academic year (e.g. "Year 1", "Masters")
    //   - activities: list of strings (required, <= 10 items) - selected interests/activities
    //   - quest: string (required, 0-100 chars) - brief description of side quest / study need
    //   - photoURL: string (required, 0-500 chars) - profile image URL or empty string
    //   - createdAt: timestamp (optional, immutable) - profile creation timestamp
    //   - lastActive: timestamp (optional) - last activity timestamp
    //
    // Collection: contacts
    // Document ID: {userId} (matches Firebase Auth UID)
    // Fields:
    //   - phoneNumber: string (required, 0-30 chars) - private phone number
    //
    // Collection: events
    // Document ID: {eventId} (UUID or custom string, 1-100 chars)
    // Model: EventItem
    // Fields:
    //   - id: string (required, 1-100 chars, immutable) - event document ID
    //   - hostId: string (required, 1-100 chars, immutable) - UID of creator/host
    //   - hostName: string (required, 1-60 chars) - display name of host
    //   - hostPhotoURL: string (required, 0-500 chars) - avatar URL of host
    //   - hostContact: string (required, 0-60 chars) - contact handle or phone number
    //   - hostMajor: string (required, 0-60 chars) - major of host
    //   - hostYear: string (required, 0-30 chars) - academic year of host
    //   - title: string (required, 1-100 chars) - title of the event / quest
    //   - description: string (required, 1-1000 chars) - detailed description
    //   - category: string (required, 1-40 chars) - category (e.g. Study, Gym, Hackathon)
    //   - location: string (required, 1-150 chars) - location or meetup spot
    //   - eventDate: timestamp (required) - scheduled event date and time
    //   - createdAt: timestamp (required, immutable) - event creation timestamp
    //   - photoURL: string (required, 0-500 chars) - event image URL or host photo URL
    //
    // Collection: swipes
    // Document ID: {swipeId} (pattern: {actorUid}_{eventId})
    // Model: SwipeRecord
    // Fields:
    //   - actor: string (required, 1-100 chars, immutable) - UID of swiping user
    //   - eventId: string (required, 1-100 chars, immutable) - ID of swiped event
    //   - hostId: string (required, 1-100 chars, immutable) - UID of event host
    //   - action: string (required, "like" or "pass") - swipe decision
    //   - createdAt: timestamp (required, immutable) - swipe timestamp
    //
    // Collection: matches
    // Document ID: {matchId} (pattern: {eventId}_{swiperId})
    // Model: MatchDoc
    // Fields:
    //   - id: string (required, 1-100 chars, immutable) - match document ID
    //   - eventId: string (required, 1-100 chars, immutable) - matched event ID
    //   - eventTitle: string (required, 0-100 chars) - title of matched event
    //   - eventCategory: string (required, 0-40 chars) - category of matched event
    //   - participants: list of strings (required, exactly 2 UIDs, immutable) - swiper & host
    //   - contacts: map of string to string (required, <= 10 keys) - phone/contact per participant
    //   - names: map of string to string (required, <= 10 keys) - display name per participant
    //   - photos: map of string to string (required, <= 10 keys) - photo URL per participant
    //   - quests: map of string to string (required, <= 10 keys) - quest/bio per participant
    //   - sharedActivities: list of strings (required, <= 10 items) - matched categories
    //   - createdAt: timestamp (optional, immutable) - match creation timestamp
    //
    // ===============================================================

    // Default deny all access at the root
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function hasActiveMatch(userId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/matches/$(request.auth.uid + '_' + userId)) ||
        exists(/databases/$(database)/documents/matches/$(userId + '_' + request.auth.uid))
      );
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'displayName', 'major', 'year', 'activities', 'quest', 'photoURL']) &&
             data.keys().hasOnly(['id', 'displayName', 'major', 'year', 'activities', 'quest', 'photoURL', 'createdAt', 'lastActive']) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 100 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.major is string && data.major.size() <= 60 &&
             data.year is string && data.year.size() <= 30 &&
             data.activities is list && data.activities.size() <= 10 &&
             data.quest is string && data.quest.size() <= 100 &&
             data.photoURL is string && data.photoURL.size() <= 500 &&
             (!('createdAt' in data) || data.createdAt is timestamp) &&
             (!('lastActive' in data) || data.lastActive is timestamp);
    }

    function isValidContact(data) {
      return data.keys().hasOnly(['phoneNumber']) &&
             data.phoneNumber is string &&
             data.phoneNumber.size() <= 30;
    }

    function isValidEvent(data) {
      return data.keys().hasAll([
               'id', 'hostId', 'hostName', 'hostPhotoURL', 'hostContact',
               'hostMajor', 'hostYear', 'title', 'description', 'category',
               'location', 'eventDate', 'createdAt', 'photoURL'
             ]) &&
             data.keys().hasOnly([
               'id', 'hostId', 'hostName', 'hostPhotoURL', 'hostContact',
               'hostMajor', 'hostYear', 'title', 'description', 'category',
               'location', 'eventDate', 'createdAt', 'photoURL'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 100 &&
             data.hostId is string && data.hostId.size() >= 1 && data.hostId.size() <= 100 &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 60 &&
             data.hostPhotoURL is string && data.hostPhotoURL.size() <= 500 &&
             data.hostContact is string && data.hostContact.size() <= 60 &&
             data.hostMajor is string && data.hostMajor.size() <= 60 &&
             data.hostYear is string && data.hostYear.size() <= 30 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 1000 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.location is string && data.location.size() >= 1 && data.location.size() <= 150 &&
             data.eventDate is timestamp &&
             data.createdAt is timestamp &&
             data.photoURL is string && data.photoURL.size() <= 500;
    }

    function isValidSwipe(data) {
      return data.keys().hasAll(['actor', 'eventId', 'hostId', 'action', 'createdAt']) &&
             data.keys().hasOnly(['actor', 'eventId', 'hostId', 'action', 'createdAt']) &&
             data.actor is string && data.actor.size() >= 1 && data.actor.size() <= 100 &&
             data.eventId is string && data.eventId.size() >= 1 && data.eventId.size() <= 100 &&
             data.hostId is string && data.hostId.size() >= 1 && data.hostId.size() <= 100 &&
             (data.action == 'like' || data.action == 'pass') &&
             data.createdAt is timestamp;
    }

    function isValidMatch(data) {
      return data.keys().hasAll([
               'id', 'eventId', 'eventTitle', 'eventCategory',
               'participants', 'contacts', 'names', 'photos',
               'quests', 'sharedActivities'
             ]) &&
             data.keys().hasOnly([
               'id', 'eventId', 'eventTitle', 'eventCategory',
               'participants', 'contacts', 'names', 'photos',
               'quests', 'sharedActivities', 'createdAt'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 100 &&
             data.eventId is string && data.eventId.size() >= 1 && data.eventId.size() <= 100 &&
             data.eventTitle is string && data.eventTitle.size() <= 100 &&
             data.eventCategory is string && data.eventCategory.size() <= 40 &&
             data.participants is list && data.participants.size() == 2 &&
             data.participants[0] is string && data.participants[1] is string &&
             data.contacts is map && data.contacts.size() <= 10 &&
             data.names is map && data.names.size() <= 10 &&
             data.photos is map && data.photos.size() <= 10 &&
             data.quests is map && data.quests.size() <= 10 &&
             data.sharedActivities is list && data.sharedActivities.size() <= 10 &&
             (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // ===============================================================
    // Rules by Collection
    // ===============================================================

    // 1. Users collection: public student profiles (no private PII)
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isOwner(userId) &&
                      request.resource.data.id == userId &&
                      isValidStudent(request.resource.data);

      allow update: if isOwner(userId) &&
                      request.resource.data.id == resource.data.id &&
                      isValidStudent(request.resource.data) &&
                      areImmutableFieldsUnchanged(['id', 'createdAt']);

      allow delete: if isOwner(userId);
    }

    // 2. Contacts collection: private phone numbers
    match /contacts/{userId} {
      allow read: if isOwner(userId) || hasActiveMatch(userId);

      allow create: if isOwner(userId) &&
                      isValidContact(request.resource.data);

      allow update: if isOwner(userId) &&
                      isValidContact(request.resource.data);

      allow delete: if isOwner(userId);
    }

    // 3. Events collection: campus study & activity quests
    match /events/{eventId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
                      request.resource.data.hostId == request.auth.uid &&
                      request.resource.data.id == eventId &&
                      isValidEvent(request.resource.data);

      allow update: if isAuthenticated() &&
                      resource.data.hostId == request.auth.uid &&
                      request.resource.data.hostId == request.auth.uid &&
                      isValidEvent(request.resource.data) &&
                      areImmutableFieldsUnchanged(['id', 'hostId', 'createdAt']);

      allow delete: if isAuthenticated() &&
                      resource.data.hostId == request.auth.uid;
    }

    // 4. Swipes collection: user swipe history
    match /swipes/{swipeId} {
      allow get: if isAuthenticated() &&
                   (resource == null || resource.data.actor == request.auth.uid);

      allow list: if isAuthenticated() &&
                    resource.data.actor == request.auth.uid;

      allow create: if isAuthenticated() &&
                      request.resource.data.actor == request.auth.uid &&
                      isValidSwipe(request.resource.data);

      allow update: if isAuthenticated() &&
                      resource.data.actor == request.auth.uid &&
                      request.resource.data.actor == request.auth.uid &&
                      isValidSwipe(request.resource.data) &&
                      areImmutableFieldsUnchanged(['actor', 'eventId', 'hostId', 'createdAt']);

      allow delete: if isAuthenticated() &&
                      resource.data.actor == request.auth.uid;
    }

    // 5. Matches collection: matched students on events
    match /matches/{matchId} {
      allow get: if isAuthenticated() &&
                   (resource == null || request.auth.uid in resource.data.participants);

      allow list: if isAuthenticated() &&
                    request.auth.uid in resource.data.participants;

      allow create: if isAuthenticated() &&
                      request.auth.uid in request.resource.data.participants &&
                      request.resource.data.id == matchId &&
                      isValidMatch(request.resource.data);

      allow update: if isAuthenticated() &&
                      request.auth.uid in resource.data.participants &&
                      request.auth.uid in request.resource.data.participants &&
                      isValidMatch(request.resource.data) &&
                      areImmutableFieldsUnchanged(['id', 'eventId', 'createdAt', 'participants']);

      allow delete: if isAuthenticated() &&
                      request.auth.uid in resource.data.participants;
    }

  }
}

